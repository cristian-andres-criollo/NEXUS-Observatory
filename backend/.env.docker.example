# =============================================================================
# NEXUS Observatory — Variables para Docker (docker-compose)
# Copia este archivo como backend/.env.docker y rellena tus valores.
# NUNCA subas backend/.env.docker al repositorio.
# =============================================================================

# DATABASE_URL lo construye docker-compose.yml a partir de POSTGRES_* del .env raíz.

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=False

# Groq (obligatorio para las funciones de IA)
GROQ_API_KEYS=

# Observabilidad (opcionales)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexus-observatory
WANDB_API_KEY=
