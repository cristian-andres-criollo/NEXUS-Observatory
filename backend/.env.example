# =============================================
# NEXUS Observatory — Variables de Entorno
# Copia este archivo como .env y rellena tus valores
# =============================================

# ── Groq LLM (OBLIGATORIO) ────────────────────────────────────────────────────
# Obtén tu API key gratis en https://console.groq.com → API Keys
# Puedes poner múltiples keys separadas por comas para rotación automática
GROQ_API_KEYS=gsk_TU_KEY_AQUI
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelos disponibles en Groq:
#   llama-3.1-8b-instant      → Rápido, ideal para la mayoría de casos
#   llama-3.3-70b-versatile   → Más preciso, ideal para análisis complejos
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CODE_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048

# ── Embeddings locales (sin API key) ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./nexus.db

# ── Observabilidad (TODAS OPCIONALES) ────────────────────────────────────────

# LangSmith — https://smith.langchain.com → Settings → API Keys
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=nexus-observatory

# W&B Weave — https://wandb.ai → Settings → API Keys
WANDB_API_KEY=
WANDB_PROJECT=nexus-observatory

# Arize Phoenix (self-hosted, requiere Phoenix corriendo localmente)
PHOENIX_HOST=http://localhost:6006

# Helicone — https://helicone.ai → Settings → API Keys
HELICONE_API_KEY=
HELICONE_BASE_URL=https://groq.helicone.ai/openai/v1

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
# Cambia esto por una cadena aleatoria de mínimo 32 caracteres
SECRET_KEY=cambia-esto-por-una-clave-secreta-de-minimo-32-caracteres

# -- Email Notifications --------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=admin@example.com
EMAIL_PASS=supersecret
EMAIL_FROM="NEXUS Admin" <admin@example.com>
