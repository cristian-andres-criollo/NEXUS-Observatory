# =============================================================================
# Variables para docker-compose. Copia este archivo como .env (no se sube a git).
# =============================================================================
# Usa una contraseña larga y distinta por instalación / cliente.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ojo: Postgres solo aplica esta contraseña al crear el volumen por primera vez.
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_db
